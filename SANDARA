#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include<time.h>

#define max_rec 100

//Creat a structure
struct BloodBag {
    int bagID;
    int donorID;
    char bloodType[5];
    time_t addedDate;
    int initialExpiryDays;
};

struct BloodBag inventory[max_rec];
int bagCount = 0;


//Define the functions
void logNDona();
void disExBlood();
void searchInType();
void calcTotUnits();
int getDaysToExpiry(struct BloodBag bag);
void NearingExpiry();

//main function
int main() {
    int choice;

    while(1) {
        printf("\n======================================================\n");
        printf(" Decentralized Blood Banking & Emergency Matching Network  \n");
        printf("======================================================\n");
        printf("1. Donor Registry          (Ranidu's Module)\n");
        printf("2. Inventory & Storage     (Sandara's Module)\n");
        printf("3. Testing & Screening     (Dilan's Module)\n");
        printf("4. Hospital Requests       (Sandapium's Module)\n");
        printf("5. Drive Logistics         (Geethanjali's Module)\n");
        printf("6. Exit System\n");
        printf("Enter module number to access: ");
        scanf("%d", &choice);

        switch(choice) {

            case 2: {
                int subChoice;
                printf("\n--- Inventory & Storage ---\n");
                printf("1. Log Donation\n2. Discard Expired\n3. Search by Type\n4. Calculate Total\n5. List Nearing Expiry\nSelect: ");
                scanf("%d", &subChoice);
                if(subChoice == 1) logNDona();
                else if(subChoice == 2) disExBlood();
                else if(subChoice == 3) searchInType();
                else if(subChoice == 4) calcTotUnits();
                else if(subChoice == 5) NearingExpiry();
                break;
            }

            case 6:
                printf("Exiting system. Goodbye!\n");
                exit(0);
            default:
                printf("Invalid choice. Please try again.\n");
        }
    }
    return 0;
}

//Function for get days to expiry
int getDaysToExpiry(struct BloodBag bag){
    time_t now=time(NULL);
    double secondsPassed=difftime(now,bag.addedDate);
    int daysPassed=secondsPassed/(60*60*24);

    int daysLeft=bag.initialExpiryDays-daysPassed;
	if (daysLeft < 0) {
	    return 0;
	} else {
	    return daysLeft;
	}


}

//Function for log new donations
void logNDona() {
    if(bagCount < max_rec) {
        printf("Enter Bag ID: ");
        scanf("%d", &inventory[bagCount].bagID);
        printf("Enter Donor ID: ");
        scanf("%d", &inventory[bagCount].donorID);
        printf("Enter Blood Type: ");
        scanf("%s", inventory[bagCount].bloodType);
        printf("Enter initial days to expiry (usually 42): ");
        scanf("%d", &inventory[bagCount].initialExpiryDays);
        inventory[bagCount].addedDate=time(NULL);
        bagCount++;
        printf("Bag added to inventory.\n");
    }
}

//Function for discard expired blood
void disExBlood() {
    int count = 0;
    for(int i = 0; i < bagCount; i++) {
        if(getDaysToExpiry(inventory[i]) <= 0) {
            inventory[i].initialExpiryDays = -1;
            count++;
        }
    }
    printf("%d expired bags discarded from system.\n", count);
}

//Function for Search inventory bt type
void searchInType() {
    char type[5];
    int count = 0;
    printf("Enter Blood Type: ");
    scanf("%s", type);
    for(int i = 0; i < bagCount; i++) {
        if(strcmp(inventory[i].bloodType, type) == 0 && getDaysToExpiry(inventory[i]) > 0) {
            count++;
        }
    }
    printf("Total available %s bags: %d\n", type, count);
}

//Function for calculate total units
void calcTotUnits() {
    int active = 0;
    for(int i = 0; i < bagCount; i++) {
        if(getDaysToExpiry(inventory[i]) > 0)
            active++;
    }
    printf("Total valid blood units in bank: %d\n", active);
}

//Function for get the list of nearing expiry
void NearingExpiry() {
	int daysLeft;
    printf("Bags expiring in less than 5 days:\n");
    for(int i = 0; i < bagCount; i++) {
        daysLeft=getDaysToExpiry(inventory[i]);
        if(daysLeft>0&&daysLeft<=5) {
            printf("Bag ID: %d | Days left: %d\n", inventory[i].bagID,daysLeft);
        }
    }
}

int main() {
    int choice;
    
    while(1) {
        printf("\n======================================================\n");
        printf(" Decentralized Blood Banking System  \n");
        printf("======================================================\n");
        printf("1. Donor Registry          (Dilan's Module)\n");
        printf("2. Inventory & Storage     (Sandara's Module)\n");
        printf("3. Testing & Screening     (Ranidu's Module)\n");
        printf("4. Hospital Requests       (Sandapiyum's Module)\n");
        printf("5. Drive Logistics         (Geethanjali's Module)\n");
        printf("6. Exit System\n");
        printf("Enter module number to access: ");
        scanf("%d", &choice);
        
        switch(choice) {
            case 4: {
                int subChoice;
                printf("\n--- Hospital Requests ---\n");
                printf("1. Log Request\n2. Match to Inventory\n3. Fulfill Request\n4. Cancel Request\n5. View High Urgency\nSelect: ");
                scanf("%d", &subChoice);
                if(subChoice == 1) logReq();
                else if(subChoice == 2)  matchReq();
                else if(subChoice == 3) fulfillReq();
                else if(subChoice == 4) cancelReq();
                else if(subChoice == 5) urgencyReq();
                break;
            }
             case 6:
                printf("Exiting system. Goodbye!\n");
                exit(0);
            default:
                printf("Invalid choice. Please try again.\n");
        }    
        }
    return 0;
}

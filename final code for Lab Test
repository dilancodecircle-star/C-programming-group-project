#include <stdio.h>
#include <string.h>
//making structure for lab test
struct LabTest {
    int testID;
    int bagId;
    char disease[50];
    char result[20];


};
#define Max_rec 100 //declare array size
struct LabTest test[Max_rec];//making array for labtest
int testcount = 0;

// declare funtions 
void logTest();
void bagsafe();
void bagGerm();
void testhistory();
void pendingtest();//function for display pending test
int main() {
    int choice , n=1, schoice;;
    while (n){
    printf("\n======================================================\n");
    printf(" Decentralized Blood Bank System  \n");
    printf("======================================================\n");
    printf("1. Donor Registry       \n");
    printf("2. Inventory & Storage      \n");
    printf("3. Testing & Screening      \n");
    printf("4. Hospital Requests        \n");
    printf("5. Drive Logistics      \n");
    printf("6. Exit System      \n");
    printf("Enter module number to access: ");
    scanf("%d", &choice);

        switch (choice) {
            case 3: // case for schoice 3
                printf("\n--- Hospital Requests ---\n");
                printf("1. Register Donor\n");
                printf("2. Mark Safe\n");
                printf("3.Mark Contaminated\n");
                printf("4. Search History\n");
                printf("5. View Pending\nSelect:");
                scanf("%d", &schoice);

               if (schoice == 1) {//calling funtion one
                   logTest();
               }
                else if (schoice==2) {// calling function two
                    bagsafe();
                }
                else if (schoice==3) {//calling function three
                    bagGerm();

                }
                else if (schoice==4) {//calling funtion four
                    testhistory();
                }
                else if (schoice==5) {// calling funtion five
                    pendingtest();
                }
                break;
            default:
                printf("Invalid choice \n");
        }
}


}
//making logtest
void logTest() {
    if (testcount<Max_rec) {
        printf("Enter the test ID : ");
        scanf("%d" , &test[testcount].testID);
        printf("Enter the bag ID : ");
        scanf("%d" , &test[testcount].bagId);
        while(getchar()!="\n");
        printf("Enter Disease Marker (e.g., HIV, HepB): ");
        fgets(test.[testcount].disease , 50 , stdin);
        test[testcount].disease[strcspn(test[testcount].disease , "\n") = '\0';
        strcpy(test[testcount].result, "Pending");
        testcount++;
        printf("Test logged successfully.\n");

    }
}
//rust blood bag as safe
void bagsafe() {
    int id;
    printf("Enter test ID : ");
    scanf("%d" , &id);
    for (int i = 0 ; i<testcount ; i++) {
        if (test[i].testID==id) {
            strcpy(test[i].result,"safe");
            printf("Bag marked as safe");
        }
    }


}
// mark blood bag with germs
void bagGerm(){
    int id;
    printf("Enter the ID : ");
    scanf("%d" , &id);
    for (int i = 0 ; i<testcount ; i++) {
        if (test[i].testID==id) {
            strcpy(test[i].result,"Germ");
            printf("WARNING Bag containe germ , dispose immediatly");

        }
    }
}
//serch bag wih bag id
void testhistory() {
    int  bId;
    printf("Enter the bag ID : ");
    scanf("%d" , &bId);
    for (int i = 0; i<testcount;i++) {
        if (test[i].bagId == bId) {
            printf("test : %d \nMarker : %s \nResult : %s" , test[i].testID , test[i].disease , test[i].result );
        }
        else{
        printf("Blood Bag not fount");
}
    }

}
// find pending blood bags
void pendingtest() {
    printf("pending Lab test :\n");
    for (int i=0;i<testcount ;i++) {
        if (strcmp(test[i].result , "Pending" ) == 0) {
            printf("Test ID : %d  ,  Bag ID : %d \n" , test[i].testID , test[i].bagId );
        }
    }

}

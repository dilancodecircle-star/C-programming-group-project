void donorregistry() {
    //registers the maximum number of donors described above
    if(donorCount < MAX_RECORDS) {
        printf("Enter Donor ID: ");
        scanf("%d", &donors[donorCount].donorID);
        printf("Enter Name: ");
        scanf("%s", donors[donorCount].name);
        printf("Enter Blood Type (e.g., O+, AB-): ");
        scanf("%s", donors[donorCount].bloodType);
        printf("Enter days since last donation: ");
        scanf("%d", &donors[donorCount].lastdonationdate);
        donorCount++;
        printf("Donor registered successfully!\n");
    } else {
        printf("Registry full!\n");
    }
}

void donorcontactupdate() {
    int id;
    printf("Enter Donor ID to update: ");
    scanf("%d", &id);
    for(int i = 0; i < donorCount; i++) {
        //checking whether the entered donor id matches with the donor id in the donors array
        if(donors[i].donorID == id) {
            printf("Enter new Name: ");
            scanf("%s", donors[i].name);
            printf("Contact updated.\n");
            return;
        }
    }
    printf("Donor not found.\n");
}

void eligibilitycheck() {
    int id;
    printf("Enter Donor ID to check: ");
    scanf("%d", &id);
    for(int i = 0; i < donorCount; i++) {
        //checking whether the id that was entered matches with id in the array
        if(donors[i].donorID == id) {
            if(donors[i].lastdonationdate > 90) {
                printf("Eligible to donate.\n");
            } else {
                printf("Not eligible. Must wait %d more days.\n", 90 - donors[i].lastdonationdate);
            }
            return;
        }
    }
    printf("Donor not found.\n");
}

void searchbybloodtype() {
    char type[5];
    printf("Enter Blood Type to search: ");
    scanf("%s", type);
    printf("Donors with type %s:\n", type);
    for(int i = 0; i < donorCount; i++) {
        //searching the blood type wanted by comparing it with the availble donors and their blood type
        if(strcmp(donors[i].bloodType, type) == 0) {
            printf("- %s (ID: %d)\n", donors[i].name, donors[i].donorID);
        }
    }
}
void eligibledonorlist(){
    printf("Currently Eligible Donors:\n");
    for(int i = 0; i < donorCount; i++) {
        //checking whether the donor has waited at least 90 days after the last donation to donate blood again
        if(donors[i].lastdonationdate > 90) {
            printf("- %s (%s)\n", donors[i].name, donors[i].bloodType);
        }
    }
}


//
//Function for get days to expiry
int getDaysToExpiry(struct BloodBag bag){
    time_t now=time(NULL);
    double secondsPassed=difftime(now,bag.addedDate);
    int daysPassed=secondsPassed/(60*60*24);

    int daysLeft=bag.initialExpiryDays-daysPassed;
	if (daysLeft < 0) {
	    return 0;
	} else {
	    return daysLeft;
	}


}

//Function for log new donations
void logNDona() {
    if(bagCount < max_rec) {
        printf("Enter Bag ID: ");
        scanf("%d", &inventory[bagCount].bagID);
        printf("Enter Donor ID: ");
        scanf("%d", &inventory[bagCount].donorID);
        printf("Enter Blood Type: ");
        scanf("%s", inventory[bagCount].bloodType);
        printf("Enter initial days to expiry (usually 42): ");
        scanf("%d", &inventory[bagCount].initialExpiryDays);
        inventory[bagCount].addedDate=time(NULL);
        bagCount++;
        printf("Bag added to inventory.\n");
    }
}

//Function for discard expired blood
void disExBlood() {
    int count = 0;
    for(int i = 0; i < bagCount; i++) {
        if(getDaysToExpiry(inventory[i]) <= 0) {
            inventory[i].initialExpiryDays = -1;
            count++;
        }
    }
    printf("%d expired bags discarded from system.\n", count);
}

//Function for Search inventory bt type
void searchInType() {
    char type[5];
    int count = 0;
    printf("Enter Blood Type: ");
    scanf("%s", type);
    for(int i = 0; i < bagCount; i++) {
        if(strcmp(inventory[i].bloodType, type) == 0 && getDaysToExpiry(inventory[i]) > 0) {
            count++;
        }
    }
    printf("Total available %s bags: %d\n", type, count);
}

//Function for calculate total units
void calcTotUnits() {
    int active = 0;
    for(int i = 0; i < bagCount; i++) {
        if(getDaysToExpiry(inventory[i]) > 0)
            active++;
    }
    printf("Total valid blood units in bank: %d\n", active);
}

//Function for get the list of nearing expiry
void NearingExpiry() {
	int daysLeft;
    printf("Bags expiring in less than 5 days:\n");
    for(int i = 0; i < bagCount; i++) {
        daysLeft=getDaysToExpiry(inventory[i]);
        if(daysLeft>0&&daysLeft<=5) {
            printf("Bag ID: %d | Days left: %d\n", inventory[i].bagID,daysLeft);
        }
    }
}



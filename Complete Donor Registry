#include <stdio.h>
#include <string.h>

#define MAX_RECORDS 100

struct Donor {
    int donorID;
    char name[50];
    char bloodType[5];
    int lastdonationdate;
};

//gets records of 100 donors
struct Donor donors[MAX_RECORDS];
int donorCount = 0;

//donor registry functions
void donorregistry();
void donorcontactupdate();
void eligiblitycheck();
void searchbybloodtype();
void eligibledonorlist();

int main() {
    int choice;
    int n=1;
    
    while(1) {
        printf("\n======================================================\n");
        printf(" Decentralized Blood Banking system  \n");
        printf("======================================================\n");
        printf("1. Donor Registry \n");
        printf("Enter module number to access: ");
        scanf("%d", &choice);
        
        switch(choice) {
            //selecting the sub part donor registry
            case 1: {
                int subChoice;
                printf("\n--- Donor Registry ---\n");
                printf("1. Register Donor\n2. Update Contact\n3. Check Eligibility\n4. Search by Blood Type\n5. List Eligible Donors\nSelect: ");
                scanf("%d", &subChoice);
                //selecting the sub functions
                if(subChoice == 1) donorregistry();
                else if(subChoice == 2) donorcontactupdate();
                else if(subChoice == 3) eligiblitycheck();
                else if(subChoice == 4) searchbybloodtype();
                else if(subChoice == 5) eligibledonorlist();
                break;
            }
            case 6:
                printf("System Terminated Successfully\n");
                n=0;
                continue;
            default:
                printf("Invalid choice. Please try again.\n");
        )
    )
)

void donorregistry() {
    //registers the maximum number of donors described above
    if(donorCount < MAX_RECORDS) {
        printf("Enter Donor ID: ");
        scanf("%d", &donors[donorCount].donorID);
        printf("Enter Name: ");
        scanf("%s", donors[donorCount].name); 
        printf("Enter Blood Type (e.g., O+, AB-): ");
        scanf("%s", donors[donorCount].bloodType);
        printf("Enter days since last donation: ");
        scanf("%d", &donors[donorCount].lastdonationdate);
        donorCount++;
        printf("Donor registered successfully!\n");
    } else {
        printf("Registry full!\n");
    }
}

void donorcontactupdate() {
    int id;
    printf("Enter Donor ID to update: ");
    scanf("%d", &id);
    for(int i = 0; i < donorCount; i++) {
        //checking whether the entered donor id matches with the donor id in the donors array
        if(donors[i].donorID == id) {
            printf("Enter new Name: ");
            scanf("%s", donors[i].name);
            printf("Contact updated.\n");
            return;
        }
    }
    printf("Donor not found.\n");
}

void eligibilitycheck() {
    int id;
    printf("Enter Donor ID to check: ");
    scanf("%d", &id);
    for(int i = 0; i < donorCount; i++) {
        //checking whether the id that was entered matches with id in the array
        if(donors[i].donorID == id) {
            if(donors[i].lastdonationdate > 90) {
                printf("Eligible to donate.\n");
            } else {
                printf("Not eligible. Must wait %d more days.\n", 90 - donors[i].daysSinceLastDonation);
            }
            return;
        }
    }
    printf("Donor not found.\n");
}

void searchbybloodtype() {
    char type[5];
    printf("Enter Blood Type to search: ");
    scanf("%s", type);
    printf("Donors with type %s:\n", type);
    for(int i = 0; i < donorCount; i++) {
        //searching the blood type wanted by comparing it with the availble donors and their blood type
        if(strcmp(donors[i].bloodType, type) == 0) {
            printf("- %s (ID: %d)\n", donors[i].name, donors[i].donorID);
        }
    }
}

void eligibledonorlist() {
    printf("Currently Eligible Donors:\n");
    for(int i = 0; i < donorCount; i++) {
        //checking whether the donor has waited at least 90 days after the last donation to donate blood again
        if(donors[i].lastdonationdate > 90) {
            printf("- %s (%s)\n", donors[i].name, donors[i].bloodType);
        }
    }
}
